# Inkdocs on Apache / LiteSpeed (most shared hosting).
# Point the domain's document root at this public/ folder.
#
# Cached pages are served straight from public/cache by the web server,
# so PHP only runs the first time a page is requested after a content change.

Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Work out the URL prefix of this folder (handles installs in a subfolder).
    RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
    RewriteRule ^(.*)$ - [E=INK_BASE:%1]

    # 1. Real files (assets, favicon, robots.txt) are served as-is.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 2. Pre-rendered page: /guide/install → cache/guide/install/index.html
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{QUERY_STRING} ^$
    RewriteRule ^/?$ - [E=INK_PAGE:index.html]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteCond %{QUERY_STRING} ^$
    RewriteRule ^(.+?)/?$ - [E=INK_PAGE:$1/index.html]
    RewriteCond %{ENV:INK_PAGE} !^$
    RewriteCond %{DOCUMENT_ROOT}%{ENV:INK_BASE}cache/%{ENV:INK_PAGE} -f
    RewriteRule ^ cache/%{ENV:INK_PAGE} [L]

    # 3. Pre-rendered data files: search.json, llms.txt, sitemap.xml, page.md
    RewriteCond %{REQUEST_URI} \.(json|xml|txt|md)$
    RewriteCond %{DOCUMENT_ROOT}%{ENV:INK_BASE}cache/$1 -f
    RewriteRule ^(.+)$ cache/$1 [L]

    # 4. Everything else goes to the PHP front controller.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_mime.c>
    AddType text/markdown .md
    AddType application/json .json
    AddCharset utf-8 .html .md .json .txt .xml
</IfModule>

<IfModule mod_headers.c>
    # Fingerprinted assets (?v=hash) can be cached for a year.
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|avif|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|json|md|txt|xml)$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/markdown text/plain application/xml image/svg+xml
</IfModule>
